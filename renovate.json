{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "baseBranchPatterns": [
    "master"
  ],
  "minimumConfidence": "high",
  "packageRules": [
    {
      "minimumConfidence": "neutral",
      "matchPackageNames": [
        "/konflux-pipelines/"
      ]
    },
    {
      "matchUpdateTypes": ["digest"],
      "minimumConfidence": "neutral"
    }
  ],
  "tekton": {
    "schedule": ["at any time"]
  }
}
